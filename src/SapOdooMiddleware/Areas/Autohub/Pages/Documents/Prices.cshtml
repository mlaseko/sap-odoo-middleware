@page "/autohub/documents/{id:guid}/prices"
@model SapOdooMiddleware.Areas.Autohub.Pages.Documents.PricesModel

<div class="page-head">
    <div>
        <h2>Price review · @(Model.Doc.InvoiceNumber ?? Model.Doc.OriginalFilename)</h2>
        <div class="sub">@Model.Doc.SupplierName · <span id="pr-currency"></span></div>
    </div>
    <div style="display:flex; gap:12px; align-items:center;">
        <a class="btn btn-sm" href="/autohub/documents/@Model.Doc.Id">← Back to invoice</a>
    </div>
</div>

<partial name="_InvoiceTabs" model="@(new SapOdooMiddleware.Areas.Autohub.Pages.Documents.InvoiceTabs(Model.Doc.Id, "prices"))" />

<style>
    /* A wide working table: give this page more room than the default 1280px. */
    main:has(#pr-bar) { max-width: 1680px; }
    #pr-table th, #pr-table td { padding: 8px 8px; font-size: 13px; }
    #pr-table thead th { font-size: 10.5px; }
    .pr-bar { display:flex; flex-wrap:wrap; gap:10px 18px; align-items:center; background:var(--surface);
              border:1px solid var(--border); border-radius:var(--radius-sm); padding:10px 14px; margin-bottom:14px; }
    .pr-bar .rc { font-weight:600; }
    .pr-bar .spacer { flex:1; }
    .pr-filter button.active { background:var(--accent-soft); border-color:var(--accent); color:var(--text-strong); }
    #pr-table td, #pr-table th { vertical-align:top; }
    #pr-table td.num, #pr-table th.num { text-align:right; white-space:nowrap; }
    #pr-table .desc { min-width:220px; }
    #pr-table .sub { color:var(--muted); font-size:12px; }
    /* PL03 box: accounting format, TZS label, no spinner; amber when changed from the calculated PL03. */
    #pr-table .money { display:inline-flex; align-items:center; width:150px; height:34px; padding:0 8px; cursor:text;
                       border:1px solid var(--border); border-radius:8px; background:var(--surface-2); }
    #pr-table .money:focus-within { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
    #pr-table .money.changed { border-color:var(--warning); }
    #pr-table .money span { color:var(--muted); font-size:11px; letter-spacing:.04em; margin-right:6px; }
    #pr-table .money input.pl03 { border:0; background:transparent; outline:none; padding:0; width:100%; text-align:right;
                                  color:var(--text-strong); font-size:14px; font-weight:600; font-variant-numeric:tabular-nums; }
    #pr-table .money-note { color:var(--muted); font-size:11.5px; margin-top:3px; font-variant-numeric:tabular-nums; }
    #pr-table input.reason { display:block; width:150px; margin:5px 0 0 auto; font-size:12px; }
    /* OEM numbers (first 3) and the vehicle pill under the part name; both open the side panel. */
    #pr-table .oem-line { font-size:12px; color:var(--muted); margin-top:3px; }
    #pr-table .oem-line a { color:var(--accent); cursor:pointer; white-space:nowrap; }
    #pr-table .fit-pill { display:inline-flex; align-items:center; gap:4px; margin-top:6px; padding:2px 10px; font-size:12px;
                          color:var(--text); background:var(--surface-2); border:1px solid var(--border); border-radius:999px; cursor:pointer; }
    #pr-table .fit-pill:hover { border-color:var(--accent); }
    #pr-table .fit-pill b { color:var(--text-strong); }
    .fit-panel { position:fixed; top:0; right:0; bottom:0; width:420px; max-width:92vw; z-index:60; overflow:auto;
                 background:var(--surface); border-left:1px solid var(--border); box-shadow:var(--shadow-pop); padding:20px 20px 28px; }
    .fit-panel h3 { margin:0 28px 2px 0; }
    .fit-panel .sub { color:var(--muted); font-size:12px; }
    .fit-panel .fit-close { position:absolute; top:14px; right:14px; width:30px; height:30px; border-radius:50%; cursor:pointer;
                            background:transparent; color:var(--text); border:1px solid var(--border); }
    .fit-panel .fit-filter { width:100%; margin:12px 0 4px; }
    .fit-panel .fit-mk { margin:14px 0 4px; font-weight:650; font-size:13px; color:var(--text-strong); }
    .fit-panel .fit-v { font-size:12.5px; padding:4px 0; border-bottom:1px solid var(--border-soft); }
    .fit-panel .fit-oems { display:flex; flex-wrap:wrap; gap:4px; }
    .fit-panel .fit-oems span { font-size:12px; padding:1px 7px; border-radius:6px; background:var(--surface-2); border:1px solid var(--border); }
    /* The table scrolls in its own window-high area so its header row stays pinned on long invoices. */
    .pr-scroll { overflow:auto; max-height:calc(100vh - 150px); border-radius:var(--radius); }
    #pr-table { overflow:visible; }
    #pr-table > thead > tr > th { position:sticky; top:0; z-index:3; box-shadow:inset 0 -1px 0 var(--border); }
    #pr-table > thead > tr > th.sortable { cursor:pointer; user-select:none; white-space:nowrap; }
    #pr-table > thead > tr > th.sortable:hover, #pr-table > thead > tr > th.sorted { color:var(--text-strong); }
    #pr-table > thead > tr > th .sort-arrow { display:inline-block; width:12px; color:var(--accent); }

    #pr-table tr.line-error td { opacity:.7; }
    .flag { display:inline-block; margin:0 4px 3px 0; }
    .pr-actions { display:flex; gap:6px; flex-wrap:nowrap; }
    .stale { color:var(--warning); font-size:12px; }
    .err { color:var(--danger); font-size:12px; }
    .rel-toggle { cursor:pointer; user-select:none; white-space:nowrap; }
    tr.rel-row > td { background:var(--surface-2); }
    .rel-summary { display:flex; flex-wrap:wrap; gap:6px 18px; margin-bottom:8px; }
    .rel-summary .big { font-size:15px; font-weight:650; }
    .pos-above { color:var(--warning); } .pos-below { color:#93c5fd; } .pos-in_line { color:var(--success); }
    table.rel { width:100%; font-size:12.5px; margin:6px 0 10px; }
    table.rel img { width:44px; height:44px; object-fit:contain; background:#fff; border-radius:4px; }
    details.other-tiers > summary { cursor:pointer; color:var(--muted); margin:6px 0; }
    table.rel img[data-zoom] { cursor:zoom-in; }
    /* The line's own part picture, as on All lines; click opens it full size (pic-zoom.js). */
    #pr-table .ln-pic { float:left; margin:0 8px 0 0; }
    #pr-table .ln-thumb { width:44px; height:44px; object-fit:contain; background:#fff; border:1px solid var(--border);
                          border-radius:4px; cursor:zoom-in; display:block; }
    #pr-table .ln-thumb:hover { border-color:var(--primary, #7c6cff); }
    #pr-table td.rel-cell { white-space:nowrap; min-width:120px; }
    #pr-table .use-median { margin-top:4px; }
    .rel-summary .use-median { margin:0; }
</style>

@if (!Model.IsEditable)
{
    <div class="note-warn">This invoice's review is completed, so prices are shown read-only.</div>
}

<div class="hint" style="margin-bottom:10px">
    @if (Model.RequirePriceReview)
    {
        <text>Bulk Create on the invoice creates <strong>only approved lines</strong>, at the PL03 approved here. Unreviewed and held lines stay to create.</text>
    }
    else
    {
        <text>Bulk Create on the invoice creates approved lines at the PL03 approved here and skips held lines. Lines not yet reviewed are created at the calculated PL03.</text>
    }
</div>

<div class="pr-bar" id="pr-bar" data-doc-id="@Model.Doc.Id" data-editable="@Model.IsEditable.ToString().ToLowerInvariant()">
    <span id="pr-counts">Loading…</span>
    <span class="spacer"></span>
    <span>
        <button class="btn btn-sm" id="pr-rel-open" type="button" title="Show the related parts of every line that has some">Expand related</button>
        <button class="btn btn-sm" id="pr-rel-close" type="button" title="Hide every related-parts list">Collapse related</button>
    </span>
    <span class="pr-filter" id="pr-filter">
        <button class="btn btn-sm active" data-f="all" type="button">All</button>
        <button class="btn btn-sm" data-f="todo" type="button">To review</button>
        <button class="btn btn-sm" data-f="flagged" type="button">Warnings</button>
        <button class="btn btn-sm" data-f="approved" type="button">Approved</button>
        <button class="btn btn-sm" data-f="held" type="button">Held</button>
    </span>
    @if (Model.IsEditable)
    {
        <button id="pr-approve-clean" class="btn btn-sm btn-primary" type="button"
                title="Approve, at the calculated PL03, every line not yet approved that has no warning and no unsaved change">
            Approve all without warnings
        </button>
    }
</div>
<div id="pr-message"></div>

<div class="pr-scroll">
<table id="pr-table">
    <thead>
        <tr>
            <th class="num">#</th>
            <th class="desc">Part</th>
            <th class="num">Qty</th>
            <th class="num">Invoice price</th>
            <th class="num">Cost CIF / PL01 (TZS)</th>
            <th class="num sortable" id="pr-sort-calc" title="Sort by calculated PL03: lowest first, highest first, invoice order"><span class="sort-arrow"></span>Calculated PL03</th>
            <th class="num">PL03 to create</th>
            <th class="num">PL05</th>
            <th class="num">Margin</th>
            <th>Warnings</th>
            <th>Decision</th>
            <th>Related parts</th>
        </tr>
    </thead>
    <tbody id="pr-body"><tr><td colspan="12">Loading…</td></tr></tbody>
</table>
</div>

<script src="~/js/autohub/pic-zoom.js" asp-append-version="true"></script>
<script src="~/js/autohub/prices.js" asp-append-version="true"></script>
