@page "/autohub/documents/{id:guid}/prices"
@model SapOdooMiddleware.Areas.Autohub.Pages.Documents.PricesModel

<div class="page-head">
    <div>
        <h2>Price review · @(Model.Doc.InvoiceNumber ?? Model.Doc.OriginalFilename)</h2>
        <div class="sub">@Model.Doc.SupplierName · <span id="pr-currency"></span></div>
    </div>
    <div style="display:flex; gap:12px; align-items:center;">
        <a class="btn btn-sm" href="/autohub/documents/@Model.Doc.Id">← Back to invoice</a>
    </div>
</div>

<partial name="_InvoiceTabs" model="@(new SapOdooMiddleware.Areas.Autohub.Pages.Documents.InvoiceTabs(Model.Doc.Id, "prices"))" />

<style>
    /* A wide working table: give this page more room than the default 1280px. */
    main:has(#pr-bar) { max-width: 1680px; }
    #pr-table th, #pr-table td { padding: 8px 8px; font-size: 13px; }
    #pr-table thead th { font-size: 10.5px; }
    .pr-bar { display:flex; flex-wrap:wrap; gap:10px 18px; align-items:center; background:var(--surface);
              border:1px solid var(--border); border-radius:var(--radius-sm); padding:10px 14px; margin-bottom:14px; }
    .pr-bar .rc { font-weight:600; }
    .pr-bar .spacer { flex:1; }
    .pr-filter button.active { background:var(--accent-soft); border-color:var(--accent); color:var(--text-strong); }
    #pr-table td, #pr-table th { vertical-align:top; }
    #pr-table td.num, #pr-table th.num { text-align:right; white-space:nowrap; }
    #pr-table .desc { min-width:220px; }
    #pr-table .sub { color:var(--muted); font-size:12px; }
    #pr-table input.pl03 { width:110px; text-align:right; }
    #pr-table input.reason { display:block; width:200px; margin:4px 0 0 auto; font-size:12px; }
    .pr-scroll { overflow-x:auto; }
    #pr-table tr.changed input.pl03 { border-color:var(--warning); }
    #pr-table tr.line-error td { opacity:.7; }
    .flag { display:inline-block; margin:0 4px 3px 0; }
    .pr-actions { display:flex; gap:6px; flex-wrap:nowrap; }
    .stale { color:var(--warning); font-size:12px; }
    .err { color:var(--danger); font-size:12px; }
    .rel-toggle { cursor:pointer; user-select:none; white-space:nowrap; }
    tr.rel-row > td { background:var(--surface-2); }
    .rel-summary { display:flex; flex-wrap:wrap; gap:6px 18px; margin-bottom:8px; }
    .rel-summary .big { font-size:15px; font-weight:650; }
    .pos-above { color:var(--warning); } .pos-below { color:#93c5fd; } .pos-in_line { color:var(--success); }
    table.rel { width:100%; font-size:12.5px; margin:6px 0 10px; }
    table.rel img { width:44px; height:44px; object-fit:contain; background:#fff; border-radius:4px; }
    details.other-tiers > summary { cursor:pointer; color:var(--muted); margin:6px 0; }
</style>

@if (!Model.IsEditable)
{
    <div class="note-warn">This invoice's review is completed, so prices are shown read-only.</div>
}

<div class="hint" style="margin-bottom:10px">
    @if (Model.RequirePriceReview)
    {
        <text>Bulk Create on the invoice creates <strong>only approved lines</strong>, at the PL03 approved here. Unreviewed and held lines stay to create.</text>
    }
    else
    {
        <text>Bulk Create on the invoice creates approved lines at the PL03 approved here and skips held lines. Lines not yet reviewed are created at the calculated PL03.</text>
    }
</div>

<div class="pr-bar" id="pr-bar" data-doc-id="@Model.Doc.Id" data-editable="@Model.IsEditable.ToString().ToLowerInvariant()">
    <span id="pr-counts">Loading…</span>
    <span class="spacer"></span>
    <span class="pr-filter" id="pr-filter">
        <button class="btn btn-sm active" data-f="all" type="button">All</button>
        <button class="btn btn-sm" data-f="todo" type="button">To review</button>
        <button class="btn btn-sm" data-f="flagged" type="button">Warnings</button>
        <button class="btn btn-sm" data-f="approved" type="button">Approved</button>
        <button class="btn btn-sm" data-f="held" type="button">Held</button>
    </span>
    @if (Model.IsEditable)
    {
        <button id="pr-approve-clean" class="btn btn-sm btn-primary" type="button"
                title="Approve, at the calculated PL03, every line not yet approved that has no warning and no unsaved change">
            Approve all without warnings
        </button>
    }
</div>
<div id="pr-message"></div>

<div class="pr-scroll">
<table id="pr-table">
    <thead>
        <tr>
            <th class="num">#</th>
            <th class="desc">Part</th>
            <th class="num">Qty</th>
            <th class="num">Invoice price</th>
            <th class="num">Cost CIF / PL01 (TZS)</th>
            <th class="num">Calculated PL03</th>
            <th class="num">PL03 to create</th>
            <th class="num">PL05</th>
            <th class="num">Margin</th>
            <th>Warnings</th>
            <th>Decision</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="pr-body"><tr><td colspan="12">Loading…</td></tr></tbody>
</table>
</div>

<script src="~/js/autohub/prices.js" asp-append-version="true"></script>
