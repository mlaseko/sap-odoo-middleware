@page "/pricing"
@model SapOdooMiddleware.Pages.Pricing.IndexModel
@functions {
    static string Money(decimal? v) => v is null ? "—" : v.Value.ToString("N0");
    static string DeltaCls(decimal? pct) => pct is null ? "" : Math.Abs(pct.Value) > 30 ? "delta-big" : pct > 0 ? "delta-up" : "delta-down";
    static string DeltaTxt(decimal? pct) => pct is null ? "new" : $"{pct:+0.#;-0.#}%";

    /// <summary>Net price or null when absent/zero (so missing shows as — not 0).</summary>
    static decimal? NetOf(IReadOnlyDictionary<int, decimal>? d, int pl)
        => d is not null && d.TryGetValue(pl, out var v) && v > 0m ? v : null;

    /// <summary>Incl-VAT shelf price reconstructed from a stored net (net × 1.18).</summary>
    static string InclOf(IReadOnlyDictionary<int, decimal>? d, int pl)
    {
        var net = NetOf(d, pl);
        return net is null ? "—" : Math.Round(net.Value * 1.18m, 0).ToString("N0");
    }

    /// <summary>"PL2 +34.2%, PL4 −31%" for tiers beyond ±30, or null when calm.</summary>
    static string? BigMoves(IReadOnlyDictionary<int, decimal?>? deltas)
    {
        if (deltas is null) return null;
        var parts = deltas.Where(kv => kv.Value is { } v && Math.Abs(v) > 30m)
                          .OrderBy(kv => kv.Key)
                          .Select(kv => $"PL{kv.Key} {kv.Value:+0.#;-0.#}%")
                          .ToList();
        return parts.Count == 0 ? null : string.Join(", ", parts);
    }
}

<style>
    /* Dark-theme aware: colors come from site.css :root variables; the .card class
       itself is the shared site style (not overridden here). */
    .price-grid { border-collapse: collapse; width: 100%; font-size: 13px; }
    .price-grid th, .price-grid td { border: 1px solid var(--border-soft); padding: 5px 9px; text-align: right; color: var(--text); }
    .price-grid th { background: var(--surface-2); color: var(--muted); text-align: center; }
    .price-grid td:first-child { text-align: left; }
    .delta-up { color: var(--warning); font-weight: 600; }
    .delta-down { color: var(--teal); font-weight: 600; }
    .delta-big { color: var(--danger); font-weight: 700; }
    .inline-form { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .inline-form input[type=text], .inline-form input[type=number], .inline-form select {
        padding: 6px 9px; border: 1px solid var(--border); border-radius: var(--radius-sm);
        background: var(--surface-2); color: var(--text);
    }
    .inline-form input:focus, .inline-form select:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
    .inline-form label { color: var(--muted); font-size: 13px; }
    .msg-ok   { background: rgba(52,211,153,.12);  border: 1px solid rgba(52,211,153,.35);  color: #6ee7b7; padding: 8px 12px; border-radius: var(--radius-sm); margin: 10px 0; }
    .msg-err  { background: rgba(248,113,113,.12); border: 1px solid rgba(248,113,113,.35); color: #fca5a5; padding: 8px 12px; border-radius: var(--radius-sm); margin: 10px 0; }
    .msg-warn { background: rgba(251,191,36,.12);  border: 1px solid rgba(251,191,36,.35);  color: #fcd34d; padding: 6px 10px; border-radius: var(--radius-sm); margin: 6px 0; font-size: 13px; }
    .meta { color: var(--muted); font-size: 12px; }
    .bulk-scroll { max-height: 420px; overflow: auto; }
    .kv-grid { display: flex; gap: 28px; flex-wrap: wrap; margin: 10px 0 6px; }
    .kv span { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: .07em; color: var(--muted-2); margin-bottom: 2px; }
    .kv b { font-size: 15px; color: var(--text-strong); }
    .row-incl td { color: var(--text-strong); font-weight: 650; }
    .row-new td { background: var(--accent-soft); }
    .row-net td { color: var(--muted); font-size: 12px; }
</style>

<div class="page-head">
    <div>
        <h2>Price Management</h2>
        <div class="sub">Lubes price lists — reprice from EUR cost through the standard workflow (SAP + Neon + Odoo)</div>
    </div>
    <a class="btn" href="/pricing/ratios">⚙ Pricing Ratios</a>
</div>

@if (Model.Message is not null) { <div class="msg-ok">@Model.Message</div> }
@if (Model.Error is not null) { <div class="msg-err">@Model.Error</div> }

@* ── EUR→TZS rate ─────────────────────────────────────────────── *@
<div class="card">
    <h3>EUR → TZS rate</h3>
    <div class="meta">
        Effective: <b>@Model.Rate.Rate.ToString("N0")</b> — source: @Model.Rate.Source
        @if (Model.Rate.UpdatedAt is not null) { <text> (updated @Model.Rate.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") UTC)</text> }
    </div>
    <form method="post" asp-page-handler="Rate" class="inline-form" style="margin-top:8px">
        <input type="number" name="newRate" step="0.01" min="1" placeholder="e.g. 3050" required />
        <button class="btn btn-primary" type="submit"
                onclick="return confirm('Set the EUR→TZS rate? Provisioning and all future repricing will use it.')">Set rate</button>
    </form>
</div>

@* ── Single item ──────────────────────────────────────────────── *@
<div class="card">
    <h3>Single item reprice</h3>
    <form method="post" asp-page-handler="Lookup" class="inline-form">
        <input type="text" name="itemCode" placeholder="Item code (LM article, e.g. 4702)"
               value="@Model.LookedUpItem" required />
        <button class="btn" type="submit">Look up</button>
    </form>

    @if (Model.Preview is { } p)
    {
        @if (!p.Found)
        {
            <div class="msg-err">@p.Error</div>
        }
        else
        {
            <div style="margin-top:10px">
                <b>@p.ItemCode</b> — @p.ItemName
                <div class="kv-grid">
                    <div class="kv"><span>Pricing band</span><b>@(p.PricingCategory ?? "unresolved")</b></div>
                    <div class="kv"><span>EUR invoice price</span><b>@(p.EurCost?.ToString("N2") ?? "—")</b></div>
                    <div class="kv"><span>Rate EUR→TZS</span><b>@p.Rate.ToString("N0")</b></div>
                    <div class="kv"><span>CIF cost TZS</span><b>@(p.CifTzs?.ToString("N0") ?? "—")</b></div>
                </div>
                <div class="meta">
                    @p.CategoryPath
                    @if (p.EurCostSource is not null) { <text> · EUR cost: @p.EurCostSource</text> }
                </div>
            </div>

            <table class="price-grid" style="margin-top:10px">
                <tr>
                    <th style="text-align:left">Price list (TZS)</th><th>PL1 Retail</th><th>PL2 Dealer</th>
                    <th>PL3 Super Dealer</th><th>PL4 Maasai</th>
                </tr>
                <tr class="row-incl">
                    <td>Current — incl VAT</td>
                    @for (int pl = 1; pl <= 4; pl++) { <td>@InclOf(p.OldNet, pl)</td> }
                </tr>
                @if (p.NewInclVat is not null)
                {
                    <tr class="row-incl row-new">
                        <td>New — incl VAT</td>
                        @for (int pl = 1; pl <= 4; pl++) { <td>@Money(NetOf(p.NewInclVat, pl))</td> }
                    </tr>
                    <tr>
                        <td>Change</td>
                        @for (int pl = 1; pl <= 4; pl++)
                        {
                            var d = p.DeltaPct?.GetValueOrDefault(pl);
                            <td class="@DeltaCls(d)">@DeltaTxt(d)</td>
                        }
                    </tr>
                }
                <tr class="row-net">
                    <td>Current — net (stored)</td>
                    @for (int pl = 1; pl <= 4; pl++) { <td>@Money(NetOf(p.OldNet, pl))</td> }
                </tr>
                @if (p.NewNet is not null)
                {
                    <tr class="row-net">
                        <td>New — net (to store)</td>
                        @for (int pl = 1; pl <= 4; pl++) { <td>@Money(NetOf(p.NewNet, pl))</td> }
                    </tr>
                }
            </table>

            @if (BigMoves(p.DeltaPct) is { } moves)
            {
                <div class="msg-warn">⚠ Beyond ±30%: @moves — double-check the EUR invoice price before posting.</div>
            }
            @if (p.Error is not null && p.Found) { <div class="msg-err">@p.Error</div> }

            <div style="margin-top:12px">
                <form method="post" asp-page-handler="Preview" class="inline-form" style="display:inline-flex">
                    <input type="hidden" name="itemCode" value="@p.ItemCode" />
                    <label>New EUR cost:</label>
                    <input type="number" name="eurCost" step="0.01" min="0.01"
                           value="@(Model.EnteredEurCost?.ToString("0.##"))" required />
                    <button class="btn" type="submit">Preview change</button>
                </form>
                @if (p.CanApply && Model.EnteredEurCost is not null)
                {
                    <form method="post" asp-page-handler="Apply" class="inline-form" style="display:inline-flex; margin-left:10px">
                        <input type="hidden" name="itemCode" value="@p.ItemCode" />
                        <input type="hidden" name="eurCost" value="@Model.EnteredEurCost" />
                        <input type="text" name="note" placeholder="reason / note (optional)" />
                        <button class="btn btn-primary" type="submit"
                                onclick="return confirm('Post these prices to SAP, Neon and Odoo?')">Confirm &amp; Post</button>
                    </form>
                }
            </div>
        }
    }

    @if (Model.Preview is { Found: true } cp && Model.SapGroups.Count > 0)
    {
        <h4 style="margin:16px 0 6px">Classification (drives the pricing band)</h4>
        <form method="post" asp-page-handler="Reclassify" class="inline-form">
            <input type="hidden" name="itemCode" value="@cp.ItemCode" />
            <label>SAP group:</label>
            <select name="groupCode">
                @foreach (var g in Model.SapGroups)
                {
                    var isCurrent = cp.CategoryPath is not null && cp.CategoryPath.Contains($"SAP group {g.Code} ");
                    <option value="@g.Code" selected="@isCurrent">@g.Code — @g.Name</option>
                }
            </select>
            <label>Odoo category:</label>
            <input type="text" name="odooCategoryPath" list="odooCats" style="min-width:280px"
                   placeholder="type to search (optional)" />
            <datalist id="odooCats">
                @foreach (var c in Model.OdooCategories)
                { <option value="@(c.FullPath ?? c.Name)"></option> }
            </datalist>
            <button class="btn btn-primary" type="submit"
                    onclick="return confirm('Reclassify this item in SAP (+ Neon/Odoo)? The pricing band may change — reprice afterwards.')">
                Save classification</button>
        </form>
    }

    @if (Model.History.Count > 0)
    {
        <h4 style="margin:16px 0 6px">Price history</h4>
        <table class="price-grid">
            <tr>
                <th style="text-align:left">When (UTC)</th><th>Mode</th><th>EUR</th><th>Rate</th>
                <th>PL1 incl</th><th>PL2 incl</th><th>PL3 incl</th><th>PL4 incl</th>
                <th style="text-align:left">Note</th>
            </tr>
            @foreach (var h in Model.History)
            {
                <tr>
                    <td style="text-align:left">@h.ChangedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@h.Mode</td>
                    <td>@(h.EurCost?.ToString("N2") ?? "—")</td>
                    <td>@(h.Rate?.ToString("N0") ?? "—")</td>
                    <td>@Money(Math.Round(h.NewPl1 * 1.18m, 0))</td>
                    <td>@Money(Math.Round(h.NewPl2 * 1.18m, 0))</td>
                    <td>@Money(Math.Round(h.NewPl3 * 1.18m, 0))</td>
                    <td>@Money(Math.Round(h.NewPl4 * 1.18m, 0))</td>
                    <td style="text-align:left">@h.Note</td>
                </tr>
            }
        </table>
    }
</div>

@* ── Bulk ─────────────────────────────────────────────────────── *@
<div class="card">
    <h3>Bulk reprice</h3>
    <div class="meta" style="margin-bottom:8px">
        Excel: columns <b>ItemCode</b> and <b>EurCost</b> (header row optional). Filter: reprices every item in a
        band from its stored EUR cost — use it after a rate change.
    </div>

    <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="inline-form">
        <input type="file" name="file" accept=".xlsx" required />
        <label>Rate override (optional):</label>
        <input type="number" name="bulkRate" step="0.01" min="1" value="@(Model.BulkRate?.ToString("0.##"))" />
        <button class="btn" type="submit">Upload &amp; preview</button>
    </form>

    <form method="post" asp-page-handler="FilterPreview" class="inline-form" style="margin-top:8px">
        <label>Or by band:</label>
        <select name="category">
            @foreach (var c in SapOdooMiddleware.Pages.Pricing.IndexModel.CategoryOptions)
            { <option value="@c">@c</option> }
        </select>
        <label>Rate override (optional):</label>
        <input type="number" name="bulkRate" step="0.01" min="1" />
        <button class="btn" type="submit">Preview band reprice</button>
    </form>

    @foreach (var e in Model.BulkParseErrors) { <div class="msg-warn">@e</div> }

    @if (Model.BulkLines.Count > 0)
    {
        <div class="bulk-scroll" style="margin-top:10px">
            <table class="price-grid">
                <tr>
                    <th style="text-align:left">Item</th><th>EUR</th>
                    <th>PL1 incl VAT old→new</th><th>PL2 incl VAT old→new</th>
                    <th>PL3 incl VAT old→new</th><th>PL4 incl VAT old→new</th>
                    <th>Δ PL1</th><th style="text-align:left">Status</th>
                </tr>
                @foreach (var l in Model.BulkLines)
                {
                    <tr>
                        <td style="text-align:left">@l.ItemCode</td>
                        <td>@(l.EurCost?.ToString("N2") ?? "—")</td>
                        @for (int pl = 1; pl <= 4; pl++)
                        {
                            <td>@InclOf(l.OldNet, pl) → @Money(NetOf(l.NewInclVat, pl))</td>
                        }
                        <td class="@DeltaCls(l.DeltaPct?.GetValueOrDefault(1))">@DeltaTxt(l.DeltaPct?.GetValueOrDefault(1))</td>
                        <td style="text-align:left">
                            @if (!l.CanApply) { <span class="delta-big">@l.Error</span> }
                            else if (l.Warnings.Count > 0) { <span class="delta-up">⚠ &gt;30%</span> }
                            else { <text>ok</text> }
                        </td>
                    </tr>
                }
            </table>
        </div>

        @if (Model.PendingBulkJson is not null)
        {
            <form method="post" asp-page-handler="BulkApply" class="inline-form" style="margin-top:10px">
                <input type="hidden" name="pendingJson" value="@Model.PendingBulkJson" />
                <input type="hidden" name="bulkRate" value="@Model.BulkRate" />
                <input type="text" name="note" placeholder="reason / note (optional)" />
                <button class="btn btn-primary" type="submit"
                        onclick="return confirm('Start the bulk reprice job? Prices post to SAP, Neon and Odoo.')">
                    Apply all applicable lines
                </button>
            </form>
        }
    }

    @if (Model.Job is { } job)
    {
        <h4 style="margin:16px 0 6px">Latest bulk job</h4>
        <div class="meta">
            @job.Status — @job.Processed / @job.TotalItems processed, @job.Applied applied,
            @job.Failed failed, @job.Warned with warnings
            (started @job.StartedAt.ToString("HH:mm:ss") UTC@(job.FinishedAt is null ? "" : $", finished {job.FinishedAt:HH:mm:ss}"))
            @if (job.Error is not null) { <span class="delta-big"> — @job.Error</span> }
        </div>
        @if (job.Status == "running")
        {
            <form method="post" asp-page-handler="StopJob" style="display:inline"><button class="btn" type="submit">Stop job</button></form>
            <a class="btn" href="/pricing">Refresh</a>
        }
        @if (job.Failures.Count > 0)
        {
            <details style="margin-top:6px"><summary>@job.Failures.Count failure(s)</summary>
                <ul>@foreach (var f in job.Failures) { <li><b>@f.ItemCode</b>: @f.Error</li> }</ul>
            </details>
        }
    }
</div>
